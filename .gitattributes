* text=auto

# KiCad sources are text; keep them LF so the tool and diffs agree
*.kicad_sch text eol=lf
*.kicad_pcb text eol=lf
*.kicad_pro text eol=lf
*.kicad_sym text eol=lf
*.kicad_mod text eol=lf

# Fabrication outputs are text; keep them LF
*.gbr text eol=lf
*.drl text eol=lf

# Vendor documents and bench evidence
*.pdf binary
*.zip binary
*.png binary
*.jpg binary
